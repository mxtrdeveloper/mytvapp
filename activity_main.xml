<?xml version="1.0" encoding="utf-8"?>
<!-- 48dp / 27dp padding = TV overscan-safe area -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:paddingLeft="48dp"
    android:paddingTop="27dp"
    android:paddingRight="48dp"
    android:paddingBottom="27dp">

    <!-- Top-left: device info + accessibility warning -->
    <LinearLayout
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDeviceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDeviceMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvAccessWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/access_warning"
            android:textColor="@color/warning_amber"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Top-right: actions (focusable for D-pad) -->
    <LinearLayout
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_button"
            android:focusable="true"
            android:stateListAnimator="@null"
            android:text="@string/btn_enable_access"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:visibility="gone">
            <requestFocus />
        </Button>

        <Button
            android:id="@+id/btnNewCode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button"
            android:focusable="true"
            android:stateListAnimator="@null"
            android:text="@string/btn_new_code"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Center: QR + address + status -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scan_title"
            android:textColor="@color/text_secondary"
            android:textSize="20sp" />

        <!-- Fixed 332dp slot so the layout doesn't jump when the QR appears -->
        <FrameLayout
            android:layout_width="332dp"
            android:layout_height="332dp"
            android:layout_marginTop="12dp">

            <FrameLayout
                android:id="@+id/qrCard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_qr_card"
                android:padding="16dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivQr"
                    android:layout_width="300dp"
                    android:layout_height="300dp"
                    android:contentDescription="Pairing QR code"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvWaiting"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/waiting_network"
                android:textColor="@color/text_secondary"
                android:textSize="20sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/statusDot"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_dot" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
